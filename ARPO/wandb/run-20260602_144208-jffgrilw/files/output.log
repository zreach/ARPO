= (1a + 1b + 1c + 1d)f(0) + (4 + 3a + 2b + c)f'(0)x + (8 + 9a + 4b + \frac{1}{2}c)f''(0)x^2 + (16 + 27a + 8b + \frac{1}{6}c)f'''(0)x^3 + (32 + 81a + 16b + \frac{1}{24}c + d)f^{(4)}(0)x^4 + \cdots
