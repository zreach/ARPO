To check if a number is prime, I can write a small function that returns True if the number is prime and False otherwise. A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself. </think>

<python>
def is_prime(n):
    if n <= 1:
        return False
    if n == 2:
        return True
    if n % 2 == 0:
        return False
    for i in range(3, int(n**0.5) + 1, 2):
        if n % i == 0:
            return False
    return True

steps_forward = 0
steps_backward = 0

for n in range(2, 31):
    if is_prime(n):
        steps_forward += 1
    else:
        steps_backward += 3

net_steps_from_start = steps_forward - steps_backward
steps_to_return = abs(net_steps_from_start)
print(steps_to_return)
