<python>
def gcd(x, y):
    while y != 0:
        (x, y) = (y, x % y)
    return x

def has_common_factor_greater_than_one(year):
    three_digit_part = year // 10
    one_digit_part = year % 10
    if three_digit_part % 2 == 0 or one_digit_part % 2 == 0:  # Exclude even numbers
        return False
    return gcd(three_digit_part, one_digit_part) > 1

year = 2007
while not has_common_factor_greater_than_one(year):
    year += 2  # Increment by 2 to ensure we always check odd years

year
</python>

