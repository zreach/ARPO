from sympy import symbols, diff, solve

# Define variables
a = symbols('a', real=True)
b_squared = 2 - a**2

# Define the expression
expr = (9 + a**2)**3 + (9 + b_squared)**3 - a**6 - b_squared**3

# Find the critical points by differentiating and setting equal to 0
