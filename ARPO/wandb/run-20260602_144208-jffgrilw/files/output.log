from functools import lru_cache

def count_sequences(current_state, remaining_jumps):
    # Base case: if we reach state D, we count it as a valid sequence
    if current_state == 'D':
        return 1

    # If we have no more jumps, we count it as a valid sequence if we're not at D
    if remaining_jumps == 0:
