# 定义符号
x, y, k = symbols('x y k')

# 圆Γ方程为 x^2 + y^2 = 1
# PM的斜率为(1-0)/(0-(-1))=1，QN的斜率为(0-(-1))/(0-1)=-1
# 直线PM的方程为 y = x + 1
# 直线QN的方程为 y = -x - 1

# 联立方程求交点T(x, y)
eq1 = Eq(y, x + 1)
eq2 = Eq(y, -x - 1)

# 解方程
solution = solve((eq1,eq2), (x, y))
T_x, T_y = solution[x], solution[y]

# 将点T坐标代入椭圆方程，求交点轨迹
eq_ellipse = Eq((T_x**2)/4 + T_y**2, 1)
ellipse_simplified = eq_ellipse.simplify()

ellipse_simplified
print(ellipse_simplified)
