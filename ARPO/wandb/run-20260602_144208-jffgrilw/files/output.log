<python>
from math import gcd

def find_odd_year_with_property(start_year):
    year = start_year + 1 if start_year % 2 == 0 else start_year
    while True:
        three_digit_part = year // 10
        one_digit_part = year % 10
        if gcd(three_digit_part, one_digit_part) > 1:
            return year
        year += 2  # Increment by 2 to check the next odd year

result = find_odd_year_with_property(2007)
result
