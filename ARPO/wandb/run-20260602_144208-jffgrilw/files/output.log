# Step 2: Calculate the number of ways to arrange the 7 digits
# There are 7! / 4! ways to arrange 7 digits with the restriction that the first digit is not 2
arrangements_per_combination = factorial(7) // factorial(4)

# Total remarkable numbers
total_remarkable_numbers = num_combinations * (arrangements_per_combination - factorial(6) // factorial(3))

print(total_remarkable_numbers)
</python>

