<python>
from sympy import symbols, diff, solve

# Define variables
a = symbols('a', real=True)
b_squared = 2 - a**2

# Define the expression
expr = (9 + a**2)**3 + (9 + b_squared)**3 - a**6 - b_squared**3

# Find the critical points by differentiating and setting equal to 0
expr_diff = expr.diff(a)
critical_points = solve(expr_diff, a)
critical_points = [point.evalf() for point in critical_points if point.is_real]

# Evaluate the expression at the critical points and boundaries
values = [expr.subs(a, point).evalf() for point in critical_points]
values.append(expr.subs(a, 0).evalf())
values.append(expr.subs(a, symbols('sqrt(2)', real=True)).evalf())

# Find the minimum value
min_value = min(values)
min_value
</python>

