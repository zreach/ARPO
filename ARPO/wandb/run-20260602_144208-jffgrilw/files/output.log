<python>
from itertools import product

# Generate all possible pairs (b, c)
pairs = list(product(range(-5, 6), repeat=2))

# Function to check if the equation has two distinct positive real roots
def has_positive_real_roots(b, c):
    discriminant = b**2 - 4*c
    return discriminant > 0 and b < 0 and c > 0

# Count the number of pairs that do not have two distinct positive real roots
count_not_positive = 0
for b, c in pairs:
    if not has_positive_real_roots(b, c):
        count_not_positive += 1

# Calculate the probability
probability = count_not_positive / len(pairs)
probability
