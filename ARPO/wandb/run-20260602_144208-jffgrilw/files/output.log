<python>
# Initialize variables
initial_balls = 1
time_limit = 60  # in seconds
balls = initial_balls
tosses = 0
current_time = 0

# Loop through each second
while current_time < time_limit:
    tosses += balls  # Tosses equal to the number of balls at the start of the second
    current_time += 1
    # Every 5 seconds, Lawrence throws another ball
    if current_time % 5 == 0 and current_time < time_limit:
        balls += 1

tosses
</python>

