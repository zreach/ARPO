<python>
from itertools import permutations

# Generate all possible four-digit numbers using the digits 1, 9, 8, and 8
digits = [1, 9, 8, 8]
unique_permutations = set(permutations(digits))

# Function to convert a tuple of digits to a number
def tuple_to_number(tup):
    return int(''.join(map(str, tup)))

# Convert each permutation to a number and filter those which leave a remainder of 8 when divided by 11
valid_numbers = [tuple_to_number(p) for p in unique_permutations if tuple_to_number(p) % 11 == 8]

# Count the valid numbers
len(valid_numbers)
