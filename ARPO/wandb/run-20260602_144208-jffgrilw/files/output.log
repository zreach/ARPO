from functools import lru_cache

# Function to calculate the probability of having g green beads after n replacements
@lru_cache(None)
def prob(g, n):
    if n == 0:
        return 1 if g == 2 else 0  # Initial condition: 2 green beads at 0 replacements
    if g == 0:  # If no green beads, all beads are red
        return 1
    if g == 4:  # If all beads are red
        return 0
    # Probability of drawing a green bead and replacing it with a red bead
    prob_green = (g / 4) * prob(0, n-1)
    # Probability of drawing a red bead and not changing the count of green beads
    prob_red = ((4 - g) / 4) * prob(g, n-1)
    return prob_green + prob_red

# Calculate the probability of having 0 green beads after 3 replacements
probability = prob(2, 3)
probability
