    yellow_numbers = [15]
    blue_numbers = [23]
    remaining_numbers = [num for num in numbers if num != black_number and num not in red_numbers and num not in yellow_numbers and num not in blue_numbers]

    # Find combinations for red, yellow, and blue
    red_combinations = list(combinations(remaining_numbers, 3))
    yellow_combinations = list(combinations([num for num in remaining_numbers if num not in [comb for comb in red_combinations]], 3))
    blue_combinations = list(combinations([num for num in remaining_numbers if num not in [comb for comb in red_combinations] and num not in [comb for comb in yellow_combinations]], 3))

