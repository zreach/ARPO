<python>
from sympy import symbols, Eq, solve

x, y = symbols('x y', integer=True)
# 定义方程
equation = Eq(x**2 + 615, 2**y)
# 搜索解
solutions = []
for i in range(1, 1000):  # 鉴于问题特性，设置一个合理范围，比如1000，确保找到所有可能的较小解
    sol = solve(equation.subs(y, i), x)
    for s in sol:
        if s.is_integer and s > 0:  # 检查解是否为正整数
            solutions.append((s, i))

(len(solutions), solutions)
