from itertools import combinations_with_replacement

def compute_x2_coefficients():
    # y + f + d = 10
    sum_total = 10
    min_val = float('inf')
    max_val = float('-inf')
    for y in range(1, sum_total):
        for f in range(1, sum_total - y):
            d = sum_total - y - f
            if d > 0:
                x2_coeff = (y*(y-1)/2) + (f*(f-1)/2) + (d*(d-1)/2)
                min_val = min(min_val, x2_coeff)
                max_val = max(max_val, x2_coeff)
    return min_val, max_val

min_val, max_val = compute_x2_coefficients()
min_max_sum = min_val + max_val
min_max_sum
