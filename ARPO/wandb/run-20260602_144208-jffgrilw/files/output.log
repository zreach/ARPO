<python>
def is_prime(num):
    if num <= 1:
        return False
    if num <= 3:
        return True
    if num % 2 == 0 or num % 3 == 0:
        return False
    i = 5
    while i * i <= num:
        if num % i == 0 or num % (i + 2) == 0:
            return False
        i += 6
    return True

def P(n):
    return n**4 + 4*n**3 + 3*n**2 - 2*n + 7

prime_count = 0
for n in range(-10, 11):
    p_value = P(n)
    if is_prime(p_value):
        prime_count += 1

prime_count
