eq2 = Eq((1 - x)**2 + (0 - y)**2 + (0 - z)**2, c_length**2 * (1 - dot_a_c.rhs)**2)
eq3 = Eq((x - 1/2)**2 + (y - sqrt(3)/2)**2 + (z - 0)**2, c_length**2 * (1 - dot_b_c.rhs)**2)

# 解方程组
