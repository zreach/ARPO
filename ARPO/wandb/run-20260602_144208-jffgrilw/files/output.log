# Function to check if the quadratic equation has two distinct positive real roots
def has_two_distinct_positive_roots(b, c):
    discriminant = b**2 - 4*c
    if discriminant <= 0:
        return False
    else:
        root1 = (-b + discriminant**0.5) / 2
        root2 = (-b - discriminant**0.5) / 2
        return root1 > 0 and root2 > 0

