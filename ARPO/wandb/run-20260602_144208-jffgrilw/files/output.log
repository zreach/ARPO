eq2 = Eq(y_prime, x + 4*y - 3)

# Solve the equations for x and y in terms of x_prime and y_prime
solution = solve((eq1, eq2), (x, y))

# Substitute solutions into the line equation and simplify
line_eq = 5*solution[x] - 2*solution[y] - (solution[y] + 5)
line_equation = Eq(line_eq, 0)
