def is_composite(x):
    """Check if a number is composite."""
    if x < 4:
        return False  # 1, 2, and 3 are not composite
    for i in range(2, int(x**0.5) + 1):
        if x % i == 0:
            return True
    return False

def find_lucky_number():
    n = 1
    while True:
        if is_composite(2*n + 1) and is_composite(3*n + 1) and is_composite(4*n + 1):
            return n
        n += 1

find_lucky_number()
