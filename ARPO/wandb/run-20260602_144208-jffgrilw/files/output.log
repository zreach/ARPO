    AC6 = x2**3
    AD6 = y2**3
    return BC6 + BD6 - AC6 - AD6

# Define the range for x2
x2_values = np.linspace(0, 2, 1000)
# Calculate the expressions for these values
results = expression(x2_values)

# Find the minimum value
min_value = np.min(results)
print(min_value)
