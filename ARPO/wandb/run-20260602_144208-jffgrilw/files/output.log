\[ |PF_1| = \sqrt{\left(\frac{a^2}{c} + c\right)^2 + y^2} \]
\[ |PF_2| = \sqrt{\left(\frac{a^2}{c} - c\right)^2 + y^2} \]

Given that $PF_1 \perp PF_2$, we can use the Pythagorean theorem on the triangle $PF_1F_2$. So:
\[ |PF_1|^2 + |PF_2|^2 = (2c)^2 = 4c^2 \]

And we are also given $|PF_1| \cdot |PF_2| = 4ab$.

By squaring the product of distances, and using the identity, we get a system of equations to solve for $c$ and $a, b$.

<python>
import sympy as sp

# Define symbols
a, b, c, y = sp.symbols('a b c y')

# Eccentricity e = c/a
e = sp.symbols('e')

# Relations
c_expr = sp.sqrt(a**2 + b**2)
eccentricity_eq = sp.Eq(c/a, e)

# Distance equations
PF1 = sp.sqrt((a**2/c + c)**2 + y**2)
PF2 = sp.sqrt((a**2/c - c)**2 + y**2)

# Cross product equation |PF1| * |PF2| = 4ab
product_eq = sp.Eq(PF1 * PF2, 4*a*b)

# Sum of squares of distances |PF1|^2 + |PF2|^2 = 4c^2
sum_squares_eq = sp.Eq(PF1**2 + PF2**2, 4*c**2)

# Substitute c = sqrt(a^2 + b^2)
sum_squares_eq = sum_squares_eq.subs(c, c_expr)
product_eq = product_eq.subs(c, c_expr)

# Solve the system for a, b, c, y
solutions = sp.solve([sum_squares_eq, product_eq], (a, b, y), dict=True)

# Filter out valid solutions
valid_solutions = [sol for sol in solutions if sol[a] > 0 and sol[b] > 0]

# Calculate eccentricity for valid solutions
eccentricities = [eccentricity_eq.subs({a: sol[a], c: c_expr.subs(sol[a], sol[a])}) for sol in valid_solutions]
eccentricities = [sol.solve(e) for sol in eccentricities]

print(valid_solutions, eccentricities)
</python>
