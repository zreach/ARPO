from sympy import symbols, solve, Eq, sqrt

# Define symbols
a, c = symbols('a c')

# Given equations
eq1 = Eq(a + c, 11)
eq2 = Eq(3*a*c, 4*(a + c + b))  # where b^2 = a^2 + c^2 - ac
b = sqrt(a**2 + c**2 - a*c)

# Solve eq1 for a in terms of c
a_expr = solve(eq1, a)[0]

# Substitute a_expr into eq2 and solve for c
eq2_sub = eq2.subs(a, a_expr)
c_value = solve(eq2_sub, c)

# Now we need to check the two values of c to determine which one is valid (a must be greater than c)
c1, c2 = c_value
a1 = a_expr.subs(c, c1)
a2 = a_expr.subs(c, c2)

# Define b in terms of the valid c
b1 = b.subs({a: a1, c: c1})
b2 = b.subs({a: a2, c: c2})

# Calculate the height from A to BC using the area formula
# Area = (1/2) * b * height
# Area = (sqrt(3)/4) * a * c
# So, height = (2 * Area) / b

height1 = (2 * (sqrt(3)/4) * a1 * c1) / b1
height2 = (2 * (sqrt(3)/4) * a2 * c2) / b2

# The valid height will be the one where a > c
valid_height = height1 if a1 > c1 else height2

print(valid_height.simplify())
