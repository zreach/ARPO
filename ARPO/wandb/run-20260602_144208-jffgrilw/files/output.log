def min_red(cubes):
    # 假定给定 n 个 3x3x3 的立方体拼成 3n x 3n x 3n 的大立方体
    n = int((cubes) ** (1/3))
    # 每个 3x3x3 立方体内染成红色的最小数量20
    red_per_cube = 20
    # 3n * 3n * 3n立方体总体中红色的数量 = 20 * n^3
    total_red = red_per_cube * n * n * n
    return total_red

# n^3 个 3x3x3 的立方体
cubes = 1  # 从最小的n=1开始
n = 1
while True:
    total_red = min_red(cubes)
    # 计算白色单元格总数 - 红色单元格数
    white = (3 * n) ** 3 - total_red
    # 检查在白色单元格中能否满足条件
    if white > 0 and (white % (26) == 0 or white % (26) == 1):
        # 形式为 (a+b)n^c
        a = 0
        b = 0
        c = 3
        if white % 26 == 0:
            b = 1
            a = (white // 26) - 1
        else:
            a = (white // 26) + 1
        result = a + b + c
        break
    cubes += 1
    n += 1
print(result)
