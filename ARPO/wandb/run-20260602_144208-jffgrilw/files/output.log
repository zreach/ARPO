def is_prime(num):
    if num <= 1:
        return False
    for i in range(2, int(num**0.5) + 1):
        if num % i == 0:
            return False
    return True

steps = 0
for n in range(2, 31):
    if is_prime(n):
        steps += 1
    else:
        steps -= 3

# The total steps taken is the absolute value of steps since I walk back to the starting point.
abs_steps = abs(steps)
print(abs_steps)
