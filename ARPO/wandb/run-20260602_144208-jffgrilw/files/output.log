# Function to calculate the probability of meeting in a round with n players
def probability_meeting(n):
    if n == 2:
        return 1  # They must meet in the only possible pairing
    elif n == 4:
        return 1/3  # One out of three possible pairings
    else:
        return (n-2)/((n-1)*(n//2-1)) * (1 + probability_meeting(n//2))

# Calculate the probability for 32 players
probability = probability_meeting(total_players)

# Reduce the fraction to lowest terms
a = int(probability * 105)  # 105 is the denominator from the pattern we observe
b = 105
common_divisor = gcd(a, b)
a //= common_divisor
b //= common_divisor

# Compute the final answer
final_answer = 100 * a + b
print(final_answer)
