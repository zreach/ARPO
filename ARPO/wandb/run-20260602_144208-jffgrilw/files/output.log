import sympy as sp

# Define the symbols
a, c = sp.symbols('a c')

# Define the equations
eq1 = sp.Eq(c + a, 11)
eq2 = sp.Eq(a * c, 22)

# Solve the system of equations
sol = sp.solve((eq1, eq2), (a, c))
a_val = sol[0][0]
c_val = sol[0][1]

# Calculate the area using A = (sqrt(3)/4) * a * c
area = (sp.sqrt(3)/4) * a_val * c_val

# Calculate the height using A = 1/2 * b * h, where b is the third side
b_val = 11 - a_val - c_val
height = (2 * area) / b_val

print(height.evalf())
