from sympy import primerange

# List of prime numbers up to the square root of 4n + 1 (since 4n + 1 is the largest)
primes = list(primerange(2, 50))  # We can adjust the upper limit based on the problem

def is_composite(num):
    for p in primes:
        if p * p > num:
            break
        if num % p == 0:
            return True
    return False

def find_lucky_number():
    n = 1
    while True:
        if is_composite(2*n + 1) and is_composite(3*n + 1) and is_composite(4*n + 1):
            return n
        n += 1

lucky_number = find_lucky_number()
print(lucky_number)
