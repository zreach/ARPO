BD_squared = 9 + d_squared

# Define the expression we need to minimize
expression = (BC_squared**3) + (BD_squared**3) - c**6 - (2 - c**2)**3

# Differentiate the expression with respect to c and find the critical points
diff_expression = diff(expression, c)
critical_points = solve(diff_expression, c)

# Evaluate the expression at the critical points and endpoints
values = [expression.subs(c, point) for point in critical_points if point.is_real]
values.append(expression.subs(c, 0))
values.append(expression.subs(c, (2**0.5)))

# Find the minimum value
min_value = min(values)
min_value
