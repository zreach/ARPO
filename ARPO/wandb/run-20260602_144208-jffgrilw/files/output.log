from itertools import product

# All possible pairs (b, c)
possible_pairs = list(product(range(-5, 6), repeat=2))

# Function to check if the quadratic equation has two distinct positive real roots
def has_two_distinct_positive_roots(b, c):
    discriminant = b**2 - 4*c
    if discriminant <= 0:
        return False
    else:
        root1 = (-b + discriminant**0.5) / 2
        root2 = (-b - discriminant**0.5) / 2
        return root1 > 0 and root2 > 0

# Count the number of pairs that do not have two distinct positive real roots
favorable_pairs = [pair for pair in possible_pairs if not has_two_distinct_positive_roots(*pair)]
probability = len(favorable_pairs) / len(possible_pairs)

print(probability)
