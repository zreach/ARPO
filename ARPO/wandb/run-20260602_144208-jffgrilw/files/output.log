# 重置最大x值获取的解
solution_2_max = max(solution_2, key=lambda x: x.subs(x, 1/2))  # 假设x在1/2或-1/2的值为最佳
solution_2_max, (1 - (x - 0.5)**2 + (solution_2_max - sqrt(3)/2)**2)**0.5
