<python>
prime_factors = []
n = 399
# Factor out the 3
while n % 3 == 0:
    prime_factors.append(3)
    n = n // 3
# Factor out the 7
while n % 7 == 0:
    prime_factors.append(7)
    n = n // 7
# The remaining factor is 19
prime_factors.append(n)
prime_factors
