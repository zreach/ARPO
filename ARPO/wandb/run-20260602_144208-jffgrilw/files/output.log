def find_next_palindromic_year(start_year, is_odd=False):
    year = start_year + 1
    while True:
        if str(year) == str(year)[::-1]:
            if not is_odd or year % 2 != 0:
                return year
        year += 1

def find_next_palindromic_prime(start_year):
    year = start_year + 1
    while True:
        if str(year) == str(year)[::-1] and isprime(year):
            return year
        year += 1

# Find the next palindromic year after 2002
next_palindromic_year_2002 = find_next_palindromic_year(2002)

# Find the next odd palindromic year after 1991
next_odd_palindromic_year_1991 = find_next_palindromic_year(1991, is_odd=True)

# Find the next palindromic prime year after 929
next_palindromic_prime_year_929 = find_next_palindromic_prime(929)

(next_palindromic_year_2002, next_odd_palindromic_year_1991, next_palindromic_prime_year_929)
