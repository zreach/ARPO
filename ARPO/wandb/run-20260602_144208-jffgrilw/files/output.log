import math

# Function to find the maximum n for which L(n) is a perfect square
def find_max_n():
    m = 1
    while True:
        n = 2 * m**2 + 1
        if (2 * (n - 1)) < (10**10):  # Arbitrarily large number to check for perfection square
            root = int(math.isqrt(2 * (n - 1)))
            if root * root == 2 * (n - 1):
                result = n
            else:
                break
        else:
            break
        m += 1
    return result

max_n = find_max_n()
