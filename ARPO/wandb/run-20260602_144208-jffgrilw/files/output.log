# 定义n的范围
n_values = [6, 5]

# 定义函数计算Sn 和 Tn
def calculate_Sn_Tn(n):
    # 假设d_a = 1, d_b = 1, 从已给比例推导Sn, Tn的关系
    # 已知a_n/b_n = (2n-1)/(3n+1), S_n = (n/2)(2a_1 + (n-1) * 1), T_n类似
    # 直接计算Sn = (n/2)(2a_1 + n-1), Tn = (n/2)(2b_1 + n-1)
    # 通过比例直接求和，无需解出a1, b1具体值
    # 利用c[n] = 2 * n - 1 / 3 * n + 1 比新华求Sn, Tn的比值

    # 计算当n增加时Sn/Tn的变化趋势，基于已知比值c[n]变化
    c_n = [(2*k-1)/(3*k+1) for k in range(1, n+1)]
    Sn = sum([2*a_1 + (k-1) for k in range(1, n+1)])
    Tn = sum([2*b_1 + (k-1) for k in range(1, n+1)])

