    \[
    |PF_1| = \sqrt{\left(\frac{a^2}{c} + c\right)^2 + y^2} = \sqrt{\left(\frac{a^2 + c^2}{c}\right)^2 + y^2} = \sqrt{\left(\frac{c^2 + a^2}{c}\right)^2 + y^2} = \sqrt{\left(\frac{2a^2}{c}\right)^2 + y^2}
