        # 如果square是完全平方数，计算对应的x
        x = int(square**0.5)
        solutions.append((x, y))
    y += 1
    # 为了防止死循环，设定一个大y值来假设超出合理解的范围
    if y > 200:
        break

print(solutions)
</python>

