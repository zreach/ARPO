# 因为 a.b = 1/2，我们可以设 c1 = 1/2 * c, c2 = 1/2 * c
# 代入得：(2 + c^2 - c) * (2 + c^2 - c) = c^2 - 2
# 解这个方程
equation = Eq((2 + c_mul**2 - c_mul) * (2 + c_mul**2 - c_mul), c_mul**2 - 2)

# 求解
solution = solve(equation, c_mul)
solution = [sol.evalf() for sol in solution if sol.is_real and sol >= 0]  # 只取实数解且非负
max_solution = max(solution)
sqrt_3_times_max_solution = sqrt(3) * max_solution

