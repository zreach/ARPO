# Define a function to generate the sequence based on the given relation
def generate_sequence(n):
    sequence = [1010, 1011]
    for i in range(2, n):
        next_term = 2 * (i + 1) - (sequence[i-1] + sequence[i-2])
        sequence.append(next_term)
    return sequence

