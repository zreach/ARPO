b_n = (3 * k + 1) * d

# S_6 和 T_5 的表示
S_6 = simplify(3 * sum(a_n.subs(k, i) for i in range(1, 7)))
T_5 = simplify(5 * sum(b_n.subs(k, i) for i in range(1, 6)))

# 计算 S_6 / T_5
ratio = S_6 / T_5
# 求出 m 和 n, 使 m/n 是最简分数
from sympy import fraction
m, n = fraction(ratio)
m_plus_n = m + n
