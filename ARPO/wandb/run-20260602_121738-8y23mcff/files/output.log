def Cauchy_Schwarz_max_value(n):
    # x0 + (x1-x2)^2/(2*n) + (x2-x3)^2/(2*n) + (x3-x1)^2/(2*n) + x1 + x2 + x3
    # 最大值为当 x0 = x1 = x2 = x3 时取到
    xi = 1 / (n - 1)  # 所有变量相等时
    S_value = (n-1) * xi + (n-1) * (3*xi)**0.5
    return S_value

