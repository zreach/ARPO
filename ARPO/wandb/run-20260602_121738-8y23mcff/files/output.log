def check_tree_is_possible(n, required_distances):
    # Create a tree with n nodes
    G = nx.Graph()
    G.add_nodes_from(range(n))
    # Add minimum number of edges to form a tree
    for i in range(1, n):
        G.add_edge(0, i)
    # Calculate the shortest paths
    distances = sorted([sum(nx.shortest_path_length(G, source=i, target=j).values()) for i in range(n) for j in range(i+1, n)])
    # Check if the distances list contains all required distances
    return set(distances) == set(required_distances)

# Required distances for n=6 are from 1 to 15
