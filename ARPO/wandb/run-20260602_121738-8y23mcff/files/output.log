# Substitute 5a1 + 35d = 120 into the expression
# 2a10 - a12 = 2(a1 + 9d) - (a1 + 11d) = 2a1 + 18d - a1 - 11d = a1 + 7d

# Since 5a1 + 35d = 120, we can express a1 + 7d as 24 (1/5 of 120)
a1_7d = solution / 5

# Therefore, the value of 2a10 - a12 is
final_value = a1_7d
print(final_value)
</python>
