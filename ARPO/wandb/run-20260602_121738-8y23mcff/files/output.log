# 检查哪些组合具有复数根
# 需要m^2 - 4n < 0
def has_complex_roots(m, n):
    return m**2 - 4*n < 0

# 对于每个组合，检查条件并累加符合条件的mn
X_sum = 0
for m, n in possible:
    if has_complex_roots(m, n):
        X_sum += m * n

print(X_sum)
