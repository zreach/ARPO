<python>
from scipy.optimize import minimize
import numpy as np

# 定义S的减函数
def S_neg(variables):
    x0, x1, x2 = variables
    n = 3
    sum1 = (x1 - x2)**2 / (2 * n) + (x2 - x0)**2 / (2 * n) + (x0 - x1)**2 / (2 * n)
    sum2 = np.sqrt(x0) + np.sqrt(x1) + np.sqrt(x2)
    return -np.sqrt(sum1 + sum2)

# 定义约束条件
constraints = [{'type': 'eq', 'fun': lambda variables: variables[0] + variables[1] + variables[2] - 1}]

# 使用minimize寻找S的最大值，使用初始值(1/3, 1/3, 1/3)作为起点
initial_guess = [1/3, 1/3, 1/3]
result = minimize(S_neg, initial_guess, constraints=constraints)

# 返回最大值（带负号，因为是求最小化）
max_S = -result.fun
max_S_value = (result.x[0], result.x[1], result.x[2], max_S)
</python>

