plt.plot(x, np.ones_like(x), 'r--', label='y = 1')
plt.fill_between(x, y1+y2, y2, where=(y1+y2 > 1) & (y2 < 1), facecolor='gray', alpha=0.5)
plt.fill_between(x, y1+y2, y1, where=(y1+y2 > 1) & (y1 < 1), facecolor='gray', alpha=0.5)
plt.fill_between(x, y1, y2, where=y1 > y2, facecolor='gray', alpha=0.5)
