    x0, x1, x2 = variables
    sum1 = (x1 - x2)**2 / (6) + (x2 - x0)**2 / (6) + (x0 - x1)**2 / (6)
    sum2 = np.sqrt(x0) + np.sqrt(x1) + np.sqrt(x2)
