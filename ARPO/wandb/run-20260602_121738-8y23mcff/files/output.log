def count_sequences(n):
    if n == 1:
        return 2  # 1 and 2 are the only valid starting numbers for natural numbers
    # dp[i][j] is the number of sequences of length i ending with j
    dp = [[0] * 4 for _ in range(n + 1)]
    dp[1][1], dp[1][2] = 1, 1  # 1 and 2 are the only valid starting numbers

    for i in range(2, n + 1):
        dp[i][1] = dp[i-1][2]  # from 2, we can get 1
        dp[i][2] = dp[i-1][1] + dp[i-1][2]  # from 1 or 2, we can get 2
        dp[i][3] = dp[i-1][2]  # from 2, we can get 3, but we only use it if the number three appears at least once

    return sum(dp[n][1:])  # sum all valid ending numbers, excluding 0 (not a natural number)

