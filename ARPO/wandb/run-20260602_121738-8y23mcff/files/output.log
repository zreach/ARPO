def star_like_distances(n):
    # In a star-like structure, the central city is connected to all other cities.
    # All distances from the central city to any other city are 1.
    # The distance between any two outer cities is 2, as they are connected indirectly through the central city.
    distances = set(range(1, n))
    for i in range(1, n-1):
        distances.update(range(2, (n-1)*(n-2)//2 + 1, 2))
    return sorted(distances)

