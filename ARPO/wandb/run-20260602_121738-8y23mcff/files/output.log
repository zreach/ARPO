<python>
import sympy as sp

# Define the angle variables
angles = [10, 20, 30, 40, 50, 60, 70, 80]

# Convert the angles to radians for calculation
angles_rad = [sp.rad(angle) for angle in angles]

# Sum the sine values using sum to product identity
numerator = sum(sp.sin(angle) for angle in angles)
simplified_numerator = 0
for i in range(0, len(angles) - 1, 2):
    sin_sum = 2 * sp.sin((angles[i] + angles[i + 1]) / 2) * sp.cos((angles[i] - angles[i + 1]) / 2)
    simplified_numerator += sin_sum
# The last term 80 degrees (5π/18 radians) is left as is
simplified_numerator += sp.sin(angles[-1])

# Since the range is from 10 to 80 with steps of 10, we can also use a direct application of the identity
# sin(10) + sin(80) = 2sin(45)cos(35), sin(20) + sin(70) = 2sin(45)cos(25), sin(30) + sin(60) = 2sin(45)cos(15), sin(40) + sin(50) = 2sin(45)cos(5)
# Summing they become 2*2sin(45)*(cos(35) + cos(25) + cos(15) + cos(5))
simplified_numerator = 2**2 * sp.sin(sp.pi/4) * (sp.cos(sp.rad(35)) + sp.cos(sp.rad(25)) + sp.cos(sp.rad(15)) + sp.cos(sp.rad(5)))

# Simplify the denominator
denominator = sp.cos(sp.rad(5)) * sp.cos(sp.rad(10)) * sp.cos(sp.rad(20))
simplified_denominator = denominator

# Simplify the ratio
simplified_ratio = simplified_numerator / simplified_denominator
simplified_ratio = sp.simplify(simplified_ratio)
simplified_ratio = sp.N(simplified_ratio)
simplified_ratio
