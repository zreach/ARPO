<python>
def check_possible_values():
    possible_values = set()
    for a in range(1, 101):  # sides are positive integers, so we limit the range for practical reasons
        for b in range(1, 101):
            A = a * b
            P = 2 * (a + b)
            possible_values.add(A + P)
    return possible_values

possible_values = check_possible_values()
print(100 in possible_values, 102 in possible_values, 104 in possible_values, 106 in possible_values, 108 in possible_values)
</python>
