from itertools import combinations

# List of first few odd primes greater than 3
primes = [5, 7, 11, 13, 17, 19, 23, 29, 31]

# Function to find the smallest sum divisible by 5
def smallest_divisible_by_5(primes):
    for r in range(4, len(primes)+1):
        for combo in combinations(primes, r):
            if sum(combo) % 5 == 0:
                return sum(combo)
    return None

