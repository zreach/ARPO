<python>
from sympy import symbols, Eq, solve

# Define symbols
a, b = symbols('a b')

# Constraints
budget_constraint = 12*a + 10*b <= 105
capacity_constraint = 240*a + 200*b >= 2040

# Find possible integer values for a and b
possible_solutions = []
for a_val in range(11):  # 0 to 10 (since 12*11 > 105)
    for b_val in range(11):  # 0 to 10 (since 10*11 > 105)
        if budget_constraint.subs({a: a_val, b: b_val}) and capacity_constraint.subs({a: a_val, b: b_val}):
            possible_solutions.append((a_val, b_val))

# Calculate the cost for each valid combination
costs = [(a_val, b_val, 12*a_val + 10*b_val) for a_val, b_val in possible_solutions]

# Find the most cost-effective solution
min_cost_solution = min(costs, key=lambda x: x[2])
num_solutions = len(possible_solutions)
print(f"Number of purchasing plans possible: {num_solutions}")
print("Most cost-effective plan:", min_cost_solution)
