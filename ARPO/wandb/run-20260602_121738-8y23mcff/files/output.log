m_values = []
n_values = []

# 遍历所有(a, b)组合
for a in A:
    for b in B:
        # 定义二次方程
        eq = Eq(x**2 + (a-b)*x + (a*b), 0)
        # 解方程
        roots = solve(eq, x)
        # 假设方程有实数根
        for root in roots:
            if root.is_real:
                m = a - b
                n = a * b
                m_values.append(m)
