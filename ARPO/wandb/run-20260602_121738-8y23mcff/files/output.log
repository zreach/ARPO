<python>
# Part (a): Two plays
n = 10  # arbitrary n, as n will cancel out in the probability calculation

# Mothers voting: 1/2 honestly, 1/2 for their child's play
# For the best play to win, it needs more than half of the votes (n + 1 votes out of 2n)
import math

# The probability that the best play will get exactly k votes out of n honest and n false votes
# This is a hypergeometric distribution
def hypergeometric_components(n, k, N, S):
    if k > N or k > S:
        return 0
    return math.comb(S, k) * math.comb(N - S, k) / math.comb(N, k)

# Calculate the probability that the best play will get more than n votes
probability = 0
for k in range(n + 1, 2*n + 1):
    probability += hypergeometric_components(n, k - n, 2*n, n)

# Part (b): More than two plays
# In this case, the number of votes for the best play will be dominated by the honest votes plus at least half the votes from the mothers whose children are not in the best play.
# The probability of the best play winning will be close to 0.5 as n grows large

print(probability, 0.5)
