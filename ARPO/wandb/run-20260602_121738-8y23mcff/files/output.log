<python>
import math

# Coordinates of vertices
A = (0,0)
B = (0,12)
C = (16,0)
A_prime = (24,18)
B_prime = (36,18)
C_prime = (24,2)

# Calculate the midpoints of AB and A'B'
mid_AB = ((A[0] + B[0]) / 2, (A[1] + B[1]) / 2)
mid_A_prime_B_prime = ((A_prime[0] + B_prime[0]) / 2, (A_prime[1] + B_prime[1]) / 2)

# Calculate the slopes of AB and A'B'
slope_AB = (B[1] - A[1]) / (B[0] - A[0])
slope_A_prime_B_prime = (B_prime[1] - A_prime[1]) / (B_prime[0] - A_prime[0])

# Slopes of the perpendicular bisectors
perp_slope_AB = -1 / slope_AB
perp_slope_A_prime_B_prime = -1 / slope_A_prime_B_prime

# Equations of the perpendicular bisectors
# y - y1 = m(x - x1)
# y - mid_AB[1] = perp_slope_AB * (x - mid_AB[0])
# y - mid_A_prime_B_prime[1] = perp_slope_A_prime_B_prime * (x - mid_A_prime_B_prime[0])
# The intersection of these lines will give the rotation center
a, b = perp_slope_A_prime_B_prime, -perp_slope_AB
c, d = mid_A_prime_B_prime[1] - mid_A_prime_B_prime[0] * perp_slope_A_prime_B_prime, mid_AB[1] - mid_AB[0] * perp_slope_AB
rotation_center_x = (b - d) / (a - b)
rotation_center_y = (a * d - c) / (a - b)
rotation_center = (rotation_center_x, rotation_center_y)

# Calculate the angle of rotation
angle_A = math.atan2(B[1] - A[1], B[0] - A[0])
angle_A_prime = math.atan2(B_prime[1] - A_prime[1], B_prime[0] - A_prime[0])

# The difference is the angle of rotation
angle_diff = angle_A_prime - angle_A
# Convert from radians to degrees
angle_degrees = math.degrees(angle_diff)

# Ensure the angle is between 0 and 180 degrees
if angle_degrees < 0:
    angle_degrees += 360
if angle_degrees > 180:
    angle_degrees = 360 - angle_degrees

# Given the rotation is clockwise, the angle must be subtracted from 360
m = 360 - angle_degrees

m, rotation_center
