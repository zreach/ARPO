# Function to find center of rotation using complex arithmetic
def find_center_and_rotation_angle(A, B, C, A_prime, B_prime, C_prime):
    # The center of rotation is the intersection of the perpendicular bisectors of the line segments AA' and BB'
    midpoint_AB = (A + B) / 2
    midpoint_Aprime_Bprime = (A_prime + B_prime) / 2
    slope_AB_to_Aprime = (cmath.phase(A_prime - A) - cmath.phase(B - A) + cmath.pi) % (2 * cmath.pi) - cmath.pi
    slope_Bprime_to_B = (cmath.phase(B_prime - B_prime) - cmath.phase(B_prime - B) + cmath.pi) % (2 * cmath.pi) - cmath.pi

