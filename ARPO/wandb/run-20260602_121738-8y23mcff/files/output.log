    factors.append(2)
    number = number // 2

# Check for odd factors
for i in range(3, int(number**0.5)+1, 2):
    while number % i == 0:
        factors.append(i)
        number = number // i

# If the remaining number is a prime greater than 2
if number > 2:
    factors.append(number)

# Output the factors
