        if total_cost <= budget_limit:
            total_capacity = model_a * model_a_capacity + model_b * model_b_capacity
            if total_capacity >= total_wastewater_treated:
                possible_plans.append((model_a, model_b, total_cost, total_capacity))

# The number of possible purchasing plans
