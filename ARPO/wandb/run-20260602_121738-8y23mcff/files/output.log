            if total_capacity >= total_wastewater_treated:
                possible_plans.append((model_a, model_b, total_cost, total_capacity))

# The number of possible purchasing plans
num_possible_plans = len(possible_plans)

# The plan with maximum treatment capacity and minimum cost
best_plan = min(possible_plans, key=lambda x: x[2])

possible_plans, num_possible_plans, best_plan
