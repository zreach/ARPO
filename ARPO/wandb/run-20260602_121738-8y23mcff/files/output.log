def S(n):
    return sum(int(digit) for digit in str(n))

def find_max_n():
    for n in range(9876543210, 0, -1):  # Start from the largest 10-digit number to find the largest n
        digits = set(str(n))
        if len(digits) == len(str(n)):  # Check if all digits are unique
            if S(3 * n) == 3 * S(n):
                return n

max_n = find_max_n()
max_n
