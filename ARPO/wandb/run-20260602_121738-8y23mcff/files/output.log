from itertools import permutations

def ternary_tree_distances(n):
    # Create a ternary tree structure for 6 cities
    # Label cities as 0, 1, 2, 3, 4, 5
    # 0 is the root, and each node has up to 3 children
    # Let's use a simple depth-first traversal to label the cities
    tree = {0: [1, 2, 3], 1: [4, 5, None], 2: [None, None, None], 3: [None, None, None]}
    cities = [0, 1, 2, 3, 4, 5]
    distances = set()

    def dfs(city, path):
        distance = path[-1] - path[0]
        distances.add(distance)
        for child in tree[city]:
            if child is not None:
                path.append(child)
                dfs(child, path)
                path.pop()

    # Start DFS from the root (city 0)
    path = [0]
    dfs(0, path)

    return distances

# Calculate distances for n = 6
